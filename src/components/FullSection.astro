---
const items = [
  { label: "Café de especialidad", icon: "☕" },
  { label: "Comidas rápidas", icon: "🥪" },
  { label: "Bebidas frías", icon: "🥤" },
  { label: "Snacks y golosinas", icon: "🍫" },
  { label: "Espacios de descanso", icon: "🛋️" },
  { label: "Atención ágil", icon: "⚡" },
];

const gallery = [
  {
    src: "/images/imagen-full-gondolas.png",
    alt: "Interior de la tienda Full con góndolas de productos",
  },
  {
    src: "/images/imagen-full-cafe.png",
    alt: "Barra de café Full con bebidas calientes",
  },
  {
    src: "/images/imagen-full-gondolas-2.png",
    alt: "Exhibidor de snacks y bebidas frías Full",
  },
];
---

<section id="full" class="full">
  <div class="container full__grid">
    <div class="full__content reveal">
      <span class="eyebrow">Tienda de conveniencia</span>
      <h2 class="section-title">Ahora también disfrutá de Full</h2>
      <p class="full__lead">
        Mientras cargás combustible, aprovechá nuestra tienda Full: café recién
        hecho, comidas rápidas, bebidas y snacks para vos y para todos los que
        viajan con vos. Un espacio moderno, luminoso y pensado para que tu
        parada sea un placer, no un trámite.
      </p>

      <ul class="full__items">
        {
          items.map((item) => (
            <li>
              <span class="full__item-icon" aria-hidden="true">
                {item.icon}
              </span>
              {item.label}
            </li>
          ))
        }
      </ul>

      <a href="/ubicacion" class="btn btn-primary">Visitá nuestra tienda Full</a>
    </div>

    <div class="full__gallery reveal reveal-delay-1">
      <!-- Imagen principal -->
      <button
        class="g-trigger g-trigger--main"
        type="button"
        aria-label={`Ampliar: ${gallery[0].alt}`}
        data-src={gallery[0].src}
        data-alt={gallery[0].alt}
      >
        <img
          src={gallery[0].src}
          alt={gallery[0].alt}
          class="full__gallery-main"
          width="800"
          height="600"
          loading="lazy"
          decoding="async"
        />
        <span class="g-hover" aria-hidden="true">
          <span class="g-hover__badge">
            <!-- Ojo SVG inline con width/height explícitos -->
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </span>
        </span>
      </button>

      <!-- Imágenes secundarias -->
      <div class="full__gallery-secondary">
        {
          [1, 2].map((i) => (
            <button
              class="g-trigger"
              type="button"
              aria-label={`Ampliar: ${gallery[i].alt}`}
              data-src={gallery[i].src}
              data-alt={gallery[i].alt}
            >
              <img
                src={gallery[i].src}
                alt={gallery[i].alt}
                width="400"
                height="400"
                loading="lazy"
                decoding="async"
              />
              <span class="g-hover" aria-hidden="true">
                <span class="g-hover__badge">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                    <circle cx="12" cy="12" r="3"/>
                  </svg>
                </span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- ── Lightbox ── -->
<div
  id="flb"
  role="dialog"
  aria-modal="true"
  aria-label="Vista ampliada"
  aria-hidden="true"
>
  <div id="flb-backdrop"></div>
  <button id="flb-close" type="button" aria-label="Cerrar imagen">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <img id="flb-img" src="" alt="" />
</div>

<!-- ── Estilos del componente (scoped) ── -->
<style>
  /* Sección */
  .full {
    background-color: var(--color-black);
    color: var(--color-white);
  }

  .full__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .full .eyebrow { color: var(--color-ypf-yellow); }

  .full__lead {
    color: rgba(255, 255, 255, 0.75);
    margin-block: 1.25rem 1.75rem;
    font-size: 1.02rem;
  }

  .full__items {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
    margin-bottom: 2.25rem;
  }

  .full__items li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.95rem;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 0.75rem 0.9rem;
  }

  .full__item-icon { font-size: 1.1rem; }

  /* Galería */
  .full__gallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .full__gallery-secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  @media (min-width: 880px) {
    .full__grid { grid-template-columns: 1.1fr 1fr; }
  }

  /* ── Triggers ── */
  .g-trigger {
    display: block;
    position: relative;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
    border-radius: var(--radius-md);
  }

  .g-trigger--main { border-radius: var(--radius-lg); }

  .g-trigger img {
    display: block;
    width: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.42s ease, filter 0.42s ease;
  }

  .full__gallery-main { aspect-ratio: 4 / 3; }

  .full__gallery-secondary .g-trigger img { aspect-ratio: 1 / 1; }

  .g-trigger:hover img,
  .g-trigger:focus-visible img {
    transform: scale(1.07);
    filter: blur(3px) brightness(0.6);
  }

  /* ── Badge de hover ── */
  .g-hover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .g-trigger:hover .g-hover,
  .g-trigger:focus-visible .g-hover {
    opacity: 1;
  }

  .g-hover__badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transform: scale(0.72);
    transition: transform 0.38s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .g-trigger:hover .g-hover__badge,
  .g-trigger:focus-visible .g-hover__badge {
    transform: scale(1);
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .g-trigger img,
    .g-hover,
    .g-hover__badge { transition: none; }
  }
</style>

<!-- ── Estilos globales: lightbox + view-transitions ── -->
<style is:global>
  /* ─── Lightbox base ─── */
  #flb {
    position: fixed;
    inset: 0;
    z-index: 800;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  #flb[data-open] {
    display: flex;
  }

  #flb-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.92);
    cursor: zoom-out;
  }

  #flb-img {
    position: relative;
    z-index: 1;
    max-width: min(94vw, 1280px);
    max-height: 90vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 18px;
    box-shadow: 0 28px 72px rgba(0, 0, 0, 0.75);
    display: block;
    /* El name se asigna solo cuando el lightbox está abierto */
    view-transition-name: none;
  }

  #flb[data-open] #flb-img {
    view-transition-name: flb-img;
  }

  #flb-backdrop {
    view-transition-name: none;
  }

  #flb[data-open] #flb-backdrop {
    view-transition-name: flb-backdrop;
  }

  #flb-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 2;
    width: 48px;
    height: 48px;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.5);
    display: grid;
    place-items: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background-color 0.2s, border-color 0.2s, transform 0.25s;
    view-transition-name: none;
  }

  #flb[data-open] #flb-close {
    view-transition-name: flb-close;
  }

  #flb-close:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.5);
    transform: rotate(90deg);
  }

  /* ─── Keyframes ─── */
  @keyframes flb-img-in {
    from { opacity: 0; transform: scale(0.86); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes flb-img-out {
    from { opacity: 1; transform: scale(1); }
    to   { opacity: 0; transform: scale(0.92); }
  }
  @keyframes flb-fade-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes flb-fade-out {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  @keyframes flb-close-in {
    from { opacity: 0; transform: rotate(-90deg) scale(0.65); }
    to   { opacity: 1; transform: rotate(0deg) scale(1); }
  }

  /* ─── View-transition: imagen ─── */
  ::view-transition-new(flb-img) {
    animation: 0.4s cubic-bezier(0.34, 1.2, 0.64, 1) both flb-img-in;
  }
  ::view-transition-old(flb-img) {
    animation: 0.25s ease both flb-img-out;
  }

  /* ─── View-transition: backdrop ─── */
  ::view-transition-new(flb-backdrop) {
    animation: 0.3s ease both flb-fade-in;
  }
  ::view-transition-old(flb-backdrop) {
    animation: 0.22s ease both flb-fade-out;
  }

  /* ─── View-transition: botón cerrar ─── */
  ::view-transition-new(flb-close) {
    animation: 0.38s 0.18s ease both flb-close-in;
  }
  ::view-transition-old(flb-close) {
    animation: 0.18s ease both flb-fade-out;
  }

  /* ─── Suprimir el crossfade del root durante el lightbox ─── */
  html.lbx-vt::view-transition-old(root),
  html.lbx-vt::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>

<!-- ── Script ── -->
<script>
  function initLightbox() {
    const lb      = document.getElementById("flb");
    const lbImg   = document.getElementById("flb-img")      as HTMLImageElement | null;
    const lbClose = document.getElementById("flb-close");
    const lbBg    = document.getElementById("flb-backdrop");

    if (!lb || !lbImg) return;

    const supportsVT = "startViewTransition" in document;
    const noMotion   = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* Corre la función de actualización del DOM dentro de una VT si es posible */
    function transition(updateFn: () => void) {
      if (supportsVT && !noMotion) {
        document.documentElement.classList.add("lbx-vt");
        const t = (document as any).startViewTransition(updateFn) as { finished: Promise<void> };
        t.finished.then(() => document.documentElement.classList.remove("lbx-vt"));
      } else {
        updateFn();
      }
    }

    function open(trigger: HTMLElement) {
      const img = trigger.querySelector("img") as HTMLImageElement;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      transition(() => {
        lb.setAttribute("data-open", "");
        lb.removeAttribute("aria-hidden");
        document.body.style.overflow = "hidden";
      });
    }

    function close() {
      transition(() => {
        lb.removeAttribute("data-open");
        lb.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      });
    }

    /* Conectar triggers */
    document.querySelectorAll<HTMLElement>(".g-trigger").forEach((t) =>
      t.addEventListener("click", () => open(t))
    );

    lbClose?.addEventListener("click", close);
    lbBg?.addEventListener("click", close);

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && lb.hasAttribute("data-open")) close();
    });

    /* Limpiar si Astro navega mientras el lightbox está abierto */
    document.addEventListener("astro:before-swap", () => {
      if (lb.hasAttribute("data-open")) {
        lb.removeAttribute("data-open");
        lb.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        document.documentElement.classList.remove("lbx-vt");
      }
    });
  }

  document.addEventListener("astro:page-load", initLightbox);
</script>
